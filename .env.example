NODE_ENV=development
APP_NAME=project-management-backend
PORT=4001
API_HOST_PORT=4001
FRONTEND_HOST_PORT=3000
APP_ADMIN_FRONTEND_URL=http://localhost:3000

# Bootstrap workspace owner. Local development uses these values; set private
# credentials in the hosting provider before starting a production container.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@pp.com
BOOTSTRAP_ADMIN_PASSWORD=U$er1234
BOOTSTRAP_ADMIN_NAME=Project Pulse Administrator

# Public portfolio demo (keep disabled for real company workspaces)
DEMO_MODE=false
DEMO_ACCOUNT_EMAIL=demo@projectpulse.app
DEMO_ACCOUNT_PASSWORD=Demo@1234

DB_NAME=project_management
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_WRITE_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_HOST_PORT=5433
DB_LOGGING=false
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_NAME=projectPulseRefreshToken
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

INVITATION_EXPIRES_HOURS=48
MAIL_TRANSPORT=json
MAIL_FROM_NAME=Project Pulse
MAIL_FROM_ADDRESS=no-reply@projectpulse.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
