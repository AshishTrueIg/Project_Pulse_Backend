{
  "name": "project-management-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API for the internal project, people, feedback and financial management platform",
  "main": "index.js",
  "engines": {
    "node": "20.18.0"
  },
  "scripts": {
    "build:clean": "rimraf ./dist && npm run build",
    "build": "babel . -d ./dist --copy-files --no-copy-ignored --ignore node_modules,test,coverage && rimraf ./dist/node_modules",
    "start": "node ./dist/index.js",
    "start:dev": "nodemon --exec babel-node ./index.js",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "sequelize": "SEQUELIZE_CLI=true babel-node ./node_modules/sequelize-cli/lib/sequelize",
    "db:create": "npm run sequelize db:create",
    "db:drop": "npm run sequelize db:drop",
    "db:migrate": "npm run sequelize db:migrate",
    "db:migrate:undo": "npm run sequelize db:migrate:undo",
    "db:seed": "npm run sequelize db:seed:all",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "ajv": "8.8.2",
    "ajv-formats": "2.1.1",
    "bcrypt": "5.0.1",
    "body-parser": "1.20.3",
    "compression": "^1.8.1",
    "convict": "6.2.4",
    "cors": "2.8.5",
    "dotenv": "10.0.0",
    "express": "4.21.2",
    "express-validator": "6.14.0",
    "helmet": "6.0.1",
    "http-status-codes": "2.2.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.1",
    "nanoid": "3.3.11",
    "pg": "8.7.1",
    "pg-hstore": "2.3.4",
    "pino": "9.5.0",
    "pino-pretty": "11.3.0",
    "sequelize": "6.12.0-beta.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/node": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "babel-plugin-module-resolver": "5.0.2",
    "jest": "30.0.5",
    "nodemon": "3.1.10",
    "rimraf": "6.0.1",
    "sequelize-cli": "6.3.0",
    "standard": "16.0.4",
    "supertest": "7.1.4"
  },
  "standard": {
    "parser": "@babel/eslint-parser",
    "env": {
      "jest": true,
      "node": true
    }
  }
}
